# Public site
NEXT_PUBLIC_SITE_URL=https://taskbook.co.in
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# Admin login (your staff phone + password)
ADMIN_PHONE=91XXXXXXXXXX
ADMIN_PASSWORD=change-this-min-8-chars

# Database — same idea as Laravel .env
# 1) CloudPanel: create database, username, password (localhost only)
# 2) Paste those three values here. Restart PM2. The site connects itself.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taskbook_web
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Optional. Email this inbox when someone books a demo.
# Leave SMTP blank and the lead is still saved under /admin/leads.
LEADS_NOTIFY_EMAIL=hello@taskbook.co.in
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Task Book <hello@taskbook.co.in>

LEADS_WEBHOOK_URL=
